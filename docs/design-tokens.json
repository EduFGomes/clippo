{
  "$description": "Clippo design tokens v2 — alinhados ao protótipo de alta fidelidade (docs/prototipos). Documentação: 04-design-system.md. Unidades: dp para tamanhos, sp para texto, ms para tempo. Medidas tiradas de um protótipo com 412 dp de largura. Cores com transparência usam 'hex' + 'opacity' (0–1) para evitar confusão entre #RRGGBBAA e #AARRGGBB.",
  "version": "2.0.0",

  "color": {
    "brand": {
      "wine":     { "hex": "#741A2F", "use": "Primária: botões, blocos de impacto, aviso Highlight salvo, ponto de gravação" },
      "wineDeep": { "hex": "#5C1425", "use": "Estado pressionado de elementos vinho" },
      "onWine":   { "hex": "#FFF1E8", "use": "Texto e ícones sobre vinho (9.8:1)" },
      "peach":    { "hex": "#FFC6A8", "use": "Accent: avatares, chips selecionados e de participante, destaque no tema escuro" },
      "onPeach":  { "hex": "#241014", "use": "Texto sobre pêssego (12:1)" }
    },

    "light": {
      "background":       { "hex": "#FBF4F0" },
      "surface":          { "hex": "#F3E4DC" },
      "text":             { "hex": "#241014" },
      "textMuted":        { "hex": "#241014", "opacity": 0.60, "note": "4.6:1 no fundo, 4.4:1 na superfície" },
      "divider":          { "hex": "#241014", "opacity": 0.10 },
      "accentForeground": { "hex": "#741A2F", "ref": "brand.wine", "use": "Vinho 'desenhado': datas, ícone/rótulo ativo, links, Sair da conta" },
      "accentSoft":       { "hex": "#741A2F", "opacity": 0.13, "use": "Fundo do item ativo da barra de navegação" },
      "cardOpenBorder":   { "hex": "#741A2F", "opacity": 0.28, "use": "Borda do card de sessão aberto" },
      "skeleton":         { "hex": "#EAD5C9", "status": "complemento — não aparece no protótipo" },
      "error":            { "hex": "#B3261E", "status": "complemento — não aparece no protótipo" }
    },

    "dark": {
      "background":       { "hex": "#141013" },
      "surface":          { "hex": "#1E1719" },
      "text":             { "hex": "#F6ECE7" },
      "textMuted":        { "hex": "#F6ECE7", "opacity": 0.62, "note": "6.5:1" },
      "divider":          { "hex": "#F6ECE7", "opacity": 0.13 },
      "accentForeground": { "hex": "#FFC6A8", "ref": "brand.peach", "note": "Vinho como texto sobre #141013 teria 1.7:1" },
      "accentSoft":       { "hex": "#741A2F", "opacity": 0.42 },
      "cardOpenBorder":   { "hex": "#741A2F", "opacity": 0.28 },
      "skeleton":         { "hex": "#2A2023", "status": "complemento — não aparece no protótipo" },
      "error":            { "hex": "#F2B8B5", "status": "complemento — não aparece no protótipo" }
    },

    "capture": {
      "background":      { "hex": "#000000", "note": "Estados B e C. Preto puro obrigatório (OLED). Independe do tema." },
      "indicator":       { "hex": "#741A2F", "ref": "brand.wine" },
      "overlay":         { "hex": "#141013", "opacity": 0.60, "use": "Botões e dica flutuando sobre a câmera" },
      "chip":            { "hex": "#FFF1E8", "opacity": 0.12, "use": "Chip não selecionado sobre a câmera" },
      "chipBorder":      { "hex": "#FFF1E8", "opacity": 0.22 },
      "textMuted":       { "hex": "#FFF1E8", "opacity": 0.70 },
      "recordRing":      { "hex": "#FFF1E8", "opacity": 0.35 },
      "ghostBorder":     { "hex": "#FFF1E8", "opacity": 0.32, "use": "Botão Cancelar gravação" }
    },

    "thumbnailPlaceholder": ["#3A2A2F", "#2E2327", "#43302F", "#2A2226"],
    "thumbnailPlayScrim":   { "hex": "#141013", "opacity": 0.55 }
  },

  "font": {
    "family": {
      "display": { "name": "Bricolage Grotesque", "source": "https://fonts.google.com/specimen/Bricolage+Grotesque", "weights": [700, 800] },
      "body":    { "name": "Instrument Sans", "source": "https://fonts.google.com/specimen/Instrument+Sans", "weights": [400, 600] }
    },
    "style": {
      "screenTitle":   { "family": "display", "weight": 800, "size": 38, "lineHeight": 1.02, "letterSpacing": -0.03, "use": "Suas sessões, Amigos" },
      "sessionTitle":  { "family": "display", "weight": 800, "size": 36, "lineHeight": 1.02, "letterSpacing": -0.03, "use": "Nome da sessão no cabeçalho vinho" },
      "formTitle":     { "family": "display", "weight": 800, "size": 32, "lineHeight": 1.04, "letterSpacing": -0.03, "use": "Confirme a sessão" },
      "statNumber":    { "family": "display", "weight": 800, "size": 34, "lineHeight": 1.0, "letterSpacing": 0, "use": "Números do Perfil" },
      "profileName":   { "family": "display", "weight": 800, "size": 30, "lineHeight": 1.1, "letterSpacing": -0.02 },
      "cardTitleOpen": { "family": "display", "weight": 800, "size": 25, "lineHeight": 1.1, "letterSpacing": -0.02 },
      "sectionTitle":  { "family": "display", "weight": 800, "size": 22, "lineHeight": 1.1, "letterSpacing": -0.02, "use": "Highlights" },
      "cardTitle":     { "family": "display", "weight": 700, "size": 20, "lineHeight": 1.1, "letterSpacing": -0.02, "use": "Card de sessão fechado" },
      "toastTitle":    { "family": "display", "weight": 800, "size": 20, "lineHeight": 1.2, "letterSpacing": -0.01 },
      "fieldValue":    { "family": "display", "weight": 700, "size": 20, "lineHeight": 1.2, "letterSpacing": 0 },
      "itemTitle":     { "family": "display", "weight": 700, "size": 18, "lineHeight": 1.15, "letterSpacing": -0.01, "use": "Título do highlight; nome de amigo usa 19" },
      "button":        { "family": "body", "weight": 600, "size": 15, "lineHeight": 1.2, "use": "Botão primário grande" },
      "buttonSmall":   { "family": "body", "weight": 600, "size": 13.5, "lineHeight": 1.2, "use": "Ver highlights (14), Convidar (13), Encerrar sessão" },
      "body":          { "family": "body", "weight": 400, "size": 14, "lineHeight": 1.4 },
      "bodyStrong":    { "family": "body", "weight": 600, "size": 14, "lineHeight": 1.4, "use": "Linhas do Perfil" },
      "caption":       { "family": "body", "weight": 400, "size": 13, "lineHeight": 1.4, "use": "Local, @usuário, saudação (600)" },
      "meta":          { "family": "body", "weight": 600, "size": 12.5, "lineHeight": 1.3, "use": "Data, nº de highlights, duração, tempo do lance, chips" },
      "overline":      { "family": "body", "weight": 600, "size": 11.5, "lineHeight": 1.3, "letterSpacing": 0.04, "textTransform": "uppercase", "use": "Rótulos de campo" },
      "navLabel":      { "family": "body", "weight": 600, "size": 10.5, "lineHeight": 1.2 }
    },
    "$note": "lineHeight em múltiplo do tamanho; letterSpacing em fração do tamanho (-0.03 = -3%)."
  },

  "space": {
    "screenGutter": 20,
    "screenTop": 14,
    "listBottomInsetWithNav": 130,
    "cardGap": 12,
    "rowGap": 11,
    "sectionGap": 22,
    "impactHeaderPadding": { "top": 16, "x": 22, "bottom": 26 },
    "minTouchTarget": 48
  },

  "radius": {
    "none": 0,
    "medium": 22,
    "large": 30,
    "full": 999,
    "$note": "none = blocos de impacto e miniaturas; medium = linha de highlight e cards de campo; large = card de sessão aberto; full = botões, chips, campos, busca, linhas do Perfil, card de sessão fechado, barra, avatares"
  },

  "border": { "width": 1 },

  "elevation": { "$note": "Sem sombras no app. Hierarquia: background < surface, mais bordas divider de 1 dp." },

  "icon": {
    "strokeWidth": 1.6,
    "grid": 24,
    "size": { "nav": 23, "action": 19, "inline": 17, "meta": 15, "hero": 34 },
    "fill": "none",
    "lineCap": "round",
    "lineJoin": "round"
  },

  "component": {
    "navBar":        { "height": 66, "insetX": 24, "insetBottom": 22, "radius": "full", "itemWidth": 82, "itemPaddingY": 9, "iconLabelGap": 4, "activeBackground": "accentSoft", "items": ["home", "capture", "friends", "profile"] },
    "buttonPrimary": { "paddingY": 18, "radius": "full", "text": "button" },
    "buttonInCard":  { "paddingY": 14, "radius": "full", "iconGap": 9, "text": "buttonSmall" },
    "buttonCompact": { "paddingY": 11, "paddingX": 17, "radius": "full", "iconGap": 7 },
    "buttonOutline": { "paddingY": 15, "paddingX": 22, "radius": "full", "border": "divider", "color": "accentForeground" },
    "sessionCard":   { "radiusClosed": "full", "radiusOpen": "large", "padding": { "top": 15, "right": 18, "bottom": 15, "left": 20 }, "chevronButton": 32, "gap": 12 },
    "impactHeader":  { "radius": "none", "background": "wine" },
    "highlightRow":  { "radius": "medium", "padding": { "top": 10, "right": 16, "bottom": 10, "left": 10 }, "gap": 14, "thumbnail": { "width": 108, "height": 68, "radius": "none" }, "playButton": 30, "rowGap": 11 },
    "fieldCard":     { "radius": "medium", "paddingY": 14, "paddingX": 20, "gap": 14 },
    "settingsRow":   { "radius": "full", "paddingY": 15, "paddingX": 22, "gap": 11 },
    "search":        { "radius": "full", "paddingY": 13, "paddingX": 20, "iconSize": 18 },
    "chip":          { "radius": "full", "paddingY": 10, "paddingX": 16, "gap": 9 },
    "chipSmall":     { "radius": "full", "paddingY": 7, "paddingX": 13, "gap": 7 },
    "avatar":        { "xs": 30, "stacked": 34, "home": 44, "list": 46, "profile": 104, "stackOverlap": -9, "stackRing": 2, "maxShown": 5 },
    "avatarEdit":    { "size": 34, "ring": 3 },
    "statBlock":     { "radius": "none", "gap": 2, "paddingY": 16, "paddingX": 14 },
    "switch":        { "width": 50, "height": 29, "knob": 23, "padding": 3 },
    "recordButton":  { "diameter": 88, "ringWidth": 3, "iconSize": 34 },
    "captureTopButton": { "diameter": 42 },
    "standbyDot":    { "diameter": 11 },
    "savedToast":    { "radius": "none", "insetX": 26, "bottom": 120, "paddingY": 16, "paddingX": 20, "iconSize": 24 }
  },

  "motion": {
    "easing":   { "standard": [0.2, 0.8, 0.2, 1] },
    "duration": { "fast": 250, "base": 300, "slow": 380 },
    "sessionCard": { "radiusMs": 300, "revealMs": 380, "contentFadeMs": 300, "contentDelayMs": 80, "chevronRotate": 180 },
    "standbyPulse": { "periodMs": 2600, "opacity": [0.45, 1], "scale": [1, 1.9] },
    "savedToast":   { "totalMs": 2600, "enterOffsetY": 14, "exitOffsetY": -6, "enterPortion": 0.12, "exitStartPortion": 0.82 },
    "stopControls": { "visibleMs": 3200 },
    "$note": "Com 'reduzir movimento' ativo no sistema: só transições de opacidade."
  }
}
