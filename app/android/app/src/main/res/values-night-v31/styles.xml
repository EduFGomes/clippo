<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 ou mais novo: a abertura do sistema usa windowSplashScreenBackground, não o
         launch_background. Vinho, como a Boas-vindas (ClippoBrand.wine). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/clippo_wine</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_empty</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
