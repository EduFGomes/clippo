rules_version = '2';

// Regras do Firestore do Clippo.
// Princípio: o app só LÊ o que precisa; dados validados no servidor são GRAVADOS
// só pelas Cloud Functions (que usam o Admin SDK e não passam por estas regras),
// exceto reações, comentários, favoritos e notificações do próprio usuário autenticado.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Perfil público: nome, @usuário, foto e contadores.
    // Qualquer pessoa logada lê UM perfil pelo uid ou busca por nome/username.
    match /users/{uid} {
      allow get, list: if signedIn();
      allow write: if isOwner(uid);

      // Favoritos privados do usuário
      match /favorites/{favoriteId} {
        allow read, write: if isOwner(uid);
      }

      // Notificações do usuário
      match /notifications/{notificationId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Trava de @usuário único. O app lê UM @ exato: para avisar "esse @ já existe" no
    // cadastro e para a busca da tela Amigos (D16).
    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow write: if false;
    }

    // Amizade ou pedido de amizade (D16): um documento por par, só as duas pessoas leem.
    // As consultas do app precisam do filtro .where('uids', arrayContains: uid).
    match /friendships/{pairId} {
      allow read: if signedIn() && request.auth.uid in resource.data.uids;
      allow write: if false;
    }

    // Pedido para juntar duas sessões (D18): só quem pediu e o dono da outra sessão leem.
    match /sessionMergeRequests/{requestId} {
      allow read: if signedIn() && request.auth.uid in resource.data.uids;
      allow write: if false;
    }

    // Dados privados (data de nascimento): só o próprio dono lê.
    match /userPrivate/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Sessão: um jogo gravado. Participantes leem todas as sessões em que estão inseridos;
    // Sessões marcadas como abertas (isOpen == true) podem ser pesquisadas/listadas por qualquer usuário logado.
    match /sessions/{sessionId} {
      function isParticipant() {
        return signedIn() && (
          (resource.data.participantIds is list && request.auth.uid in resource.data.participantIds) ||
          resource.data.ownerId == request.auth.uid
        );
      }

      allow read: if isParticipant() || (signedIn() && resource.data.isOpen == true);
      allow write: if false;

      // Highlights da sessão.
      match /highlights/{highlightId} {
        allow read: if signedIn();
        allow write: if false;

        // Comentários do highlight
        match /comments/{commentId} {
          allow read: if signedIn();
          allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
          allow delete: if signedIn() && resource.data.userId == request.auth.uid;
        }

        // Reações do highlight
        match /reactions/{reactionId} {
          allow read: if signedIn();
          allow create, update: if signedIn() && request.resource.data.userId == request.auth.uid;
          allow delete: if signedIn() && resource.data.userId == request.auth.uid;
        }
      }
    }

    // Todo o resto continua bloqueado até ganhar regras próprias.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
