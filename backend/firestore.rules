rules_version = '2';

// Regras do Firestore do Clippo.
// Princípio: o app só LÊ o que precisa; dados validados no servidor são GRAVADOS
// só pelas Cloud Functions (que usam o Admin SDK e não passam por estas regras).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Perfil público: nome, @usuário, foto e contadores.
    // Qualquer pessoa logada lê UM perfil pelo uid (amigos, participantes). Ninguém LISTA
    // a coleção: senão um script com uma conta baixaria nome e foto de todo mundo.
    // Ninguém grava pelo app: a criação passa por completeProfile, que valida tudo.
    match /users/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow write: if false;
    }

    // Trava de @usuário único. O app lê UM @ exato: para avisar "esse @ já existe" no
    // cadastro e para a busca da tela Amigos (D16). Listar daria a lista de todos os @.
    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow write: if false;
    }

    // Amizade ou pedido de amizade (D16): um documento por par, só as duas pessoas leem.
    // As consultas do app precisam do filtro .where('uids', arrayContains: uid).
    match /friendships/{pairId} {
      allow read: if signedIn() && request.auth.uid in resource.data.uids;
      allow write: if false;
    }

    // Pedido para juntar duas sessões (D18): só quem pediu e o dono da outra sessão leem.
    match /sessionMergeRequests/{requestId} {
      allow read: if signedIn() && request.auth.uid in resource.data.uids;
      allow write: if false;
    }

    // Dados privados (data de nascimento): só o próprio dono lê.
    match /userPrivate/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Sessão: um jogo gravado. Só quem jogou junto vê (R11); quem não é participante
    // não vê nada da sessão. A lista de participantes está no próprio documento
    // (participantIds), o que permite a consulta da Início numa só ida ao banco.
    //
    // ATENÇÃO para quem escreve a consulta: as regras são avaliadas documento por
    // documento, então listar sessions SEM o filtro .where('participantIds',
    // arrayContains: uid) falha inteira ao encontrar a primeira sessão de outra pessoa.
    match /sessions/{sessionId} {
      function isParticipant() {
        return signedIn() && request.auth.uid in resource.data.participantIds;
      }

      allow read: if isParticipant();

      // Escrita fechada para o app: só Functions gravam (D15 em
      // docs/arquitetura.md › Quem grava sessões e highlights).
      allow write: if false;

      // Highlights da sessão. A permissão vem da sessão: todo participante vê todos
      // os highlights dela (R11). Custa uma leitura a mais (o get da sessão), e em
      // troca a permissão nunca fica desatualizada quando os participantes mudam (R12).
      match /highlights/{highlightId} {
        allow read: if signedIn() && request.auth.uid in
            get(/databases/$(database)/documents/sessions/$(sessionId)).data.participantIds;
        allow write: if false;
      }
    }

    // Todo o resto continua bloqueado até ganhar regras próprias.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
